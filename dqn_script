#!/bin/bash

run() {
    echo "Starting training"
    python code/dqn_training.py \
        --episodes 5000  \
        --eval-episodes 200 \
        --batch-size 128 \
        --random-seed Y \
        --output ./results/dqn.csv 

    echo "Finished training and Evaluation"
    echo "Now analyzing results"

    python code/analyze_results.py \
        --input-file ./results/dqn.csv \
        --output-file ./results/dqn \
        --window 100

    echo "Analyzing results complete"

    echo "Running test"
    python code/test_dqn.py \
    --episodes 10
}

analyze() {
    python code/analyze_results.py \
        --input-file ./results/dqn.csv \
        --output-file ./results/dqn \
        --window 100
}

test() {
    python code/test_dqn.py \
    --episodes 10
}

case "$1" in
    run)
        run
        ;;
    analyze)
        analyze
        ;;
    test)
        test
        ;;
    *)
        echo "Usage: $0 {run|analyze|test}"
        exit 1
        ;;
esac
